# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ray_dev

# Razorpay API (Development)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM Provider
# Supported: anthropic, openai
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Application
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Simulator Configuration
SIMULATION_SEED=42
WORLD_SEED=42
TRAINING_SEED=43
EVALUATION_SEED=44
BOOTSTRAP_SEED=45

# V1 Configuration Defaults
ASSUMED_ORGANIC_RECOVERY_RATE=0.04
MAX_ACTIONS_PER_DAY=10
MAX_CONTACTS_PER_CUSTOMER_PER_DAY=1
DO_NOT_CONTACT_FRACTION=0.05
AUTONOMOUS_AMOUNT_LIMIT=25000
LLM_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.70
PAYMENT_LINK_INTERVENTION_COST=0
CUSTOMER_FRICTION_COST_PER_CONTACT=5
RISK_PENALTY=0

# Evaluation
SIMULATION_DAYS=10
BOOTSTRAP_ITERATIONS=1000
